{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "types": ["node", "@playwright/test"],
    "baseUrl": ".",
    "paths": {
            "@config/*": ["src/config/*"],
            "@pages/*": ["src/pages/*"],
            "@test-data/*": ["src/test-data/*"],
             "@types/*": ["src/types/*"]
        },
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
, "tests/login.spec.ts"  ]
}